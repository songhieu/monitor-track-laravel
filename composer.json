{
    "name": "songhieu/monitor-track-laravel",
    "description": "Laravel SDK for monitor-track App Logs: exceptions with stack frames, queue job runs, scheduled task runs and worker heartbeats. Fail-open, never slows the app.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "logging",
        "monitoring",
        "queue",
        "scheduler",
        "monitor-track"
    ],
    "require": {
        "php": "^8.0",
        "illuminate/console": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "monolog/monolog": "^2.0|^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.5.10|^10.5|^11.0|^12.0"
    },
    "suggest": {
        "ext-curl": "Used by the http transport (falls back to PHP streams without it).",
        "ext-zlib": "Gzip-compresses http transport batches."
    },
    "autoload": {
        "psr-4": {
            "MonitorTrack\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MonitorTrack\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MonitorTrack\\MonitorTrackServiceProvider"
            ],
            "aliases": {
                "MonitorTrack": "MonitorTrack\\Facades\\MonitorTrack"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
